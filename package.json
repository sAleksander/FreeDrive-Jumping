{
  "name": "freedrive-jumping",
  "version": "0.1.0",
  "private": true,
  "description": "Electron + React shell for Parrot Jumping drone control.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron:tsc\" \"npm:dev:electron:app\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5173",
    "dev:electron:tsc": "tsc -p tsconfig.electron.json --watch",
    "dev:electron:app": "wait-on dist-electron/main.js tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist-electron/main.js",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "start": "electron dist-electron/main.js"
  },
  "dependencies": {
    "node-sumo": "github:alronz/node-sumo",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.2",
    "wait-on": "^9.0.4"
  }
}
